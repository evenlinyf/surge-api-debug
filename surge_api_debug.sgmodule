#!name=Surge API Debug
#!category=Dev
#!desc=通用 API 调试/故障注入。Module v1.0.0，Script v1.0.0。多个模块可修改不同接口，按 URL 正则与方向分别计数和重置。支持 Body 字符串格式化。使用方法参考https://github.com/evenlinyf/surge-api-debug#readme
#!arguments=url,direction:response,target:body,action:set,path,value,value_type:string,hit_limit:0,delay_ms:0
#!arguments-desc=url=完整 URL 或简单正则；\ndirection=request/response；\ntarget=body/header/url/status；\naction=set/format/remove/mock/abort，format 仅支持 Body 字符串字段；\npath=Body JSON 路径或 Header 名，$ 表示整个 Body，数组下标用 [n]，可用 [?(@.field == value)] 筛选；\nvalue=新值，@empty 表示空字符串；format 可用 ${old} 引用字段原值，& 可直接输入，也可用百分号转义；\nvalue_type=string/number/boolean/null/json，format 使用 string；\nhit_limit=生效次数，0 或留空每次生效，3 只在前 3 次生效，-3 从第 4 次起每次生效。在「重置次数」信息面板查看进度，点刷新可清零；\ndelay_ms=仅操作生效时增加延迟，0~25000 毫秒；未命中或配置错误不延迟。

[Script]
API Debug = type=http-{{{direction}}}, pattern="{{{url}}}", script-path=https://raw.githubusercontent.com/evenlinyf/surge-api-debug/v1.0.0/surge_api_debug.js, requires-body=true, max-size=4194304, timeout=30, debug=true, argument="url_pattern={{{url}}}, target={{{target}}}&action={{{action}}}&path={{{path}}}&value={{{value}}}&value_type={{{value_type}}}&hit_limit={{{hit_limit}}}&delay_ms={{{delay_ms}}}&module_version=1.0.0"
API-Debug-Reset = type=generic, script-path=https://raw.githubusercontent.com/evenlinyf/surge-api-debug/v1.0.0/surge_api_debug.js, argument="url_pattern={{{url}}}, target=reset&direction={{{direction}}}&hit_limit={{{hit_limit}}}&module_version=1.0.0"

[Panel]
"API-Debug-Reset|{{{direction}}}|{{{hit_limit}}}|{{{url}}}" = title="重置次数 · hit_limit={{{hit_limit}}}", content="{{{direction}}} · {{{url}}}\n点刷新清零此接口的生效次数", style=info, script-name=API-Debug-Reset, update-interval=1
